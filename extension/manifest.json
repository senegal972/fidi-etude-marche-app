{
  "manifest_version": 3,
  "name": "FIDI ACM — Comparables immobiliers",
  "version": "1.1.0",
  "description": "Envoie les annonces SeLoger, LeBonCoin et DomImmo vers votre app FIDI (avis de valeur).",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.seloger.com/*",
    "https://www.leboncoin.fr/*",
    "https://www.domimmo.com/*",
    "https://*.netlify.app/*",
    "https://fidiconseil.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "FIDI ACM"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.seloger.com/*"],
      "js": ["content-shared.js", "content-seloger.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.leboncoin.fr/*"],
      "js": ["content-shared.js", "content-leboncoin.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.domimmo.com/*"],
      "js": ["content-shared.js", "content-domimmo.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
